# Campaign Agent LLM Providers (optional)
# Leave all keys empty to run in zero-cost deterministic Demo Mode.
# Any missing or rate-limited provider falls back down the chain, then to Demo Mode.

# 1. Primary: Google Gemini REST API (supports text + multimodal image uploads)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 2. Secondary: Groq API (OpenAI-compatible)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# 3. Tertiary: OpenRouter API (OpenAI-compatible)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Optional custom API base URL for split frontend/backend deployments
# VITE_API_BASE_URL=
